# === CLEANUP ADDITIONS ===
# Virtual environments
venv311/
# Cache and temporary files
cache/
*.session
*.log
# System files
# Python cache
# IDE files
.vscode/settings.json
.idea/
# Large data files
data/raw/downloaded_pdfs/*.pdf
*.gpkg
asset_database_full.csv

# Video files
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text

# Image files
*.jpg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text

# GIS files
*.gpkg filter=lfs diff=lfs merge=lfs -text
*.shp filter=lfs diff=lfs merge=lfs -text

# Document files
data/raw/downloaded_pdfs/*.pdf filter=lfs diff=lfs merge=lfs -text

# Database files
*.csv filter=lfs diff=lfs merge=lfs -text
asset_database_full.csv filter=lfs diff=lfs merge=lfs -text

# Large Data Management
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Allow specific data directories
!data/processed/address_variants/
!data/processed/analysis_logs/

# Exclude large files even if committed
*.mp4
*.avi
*.jpg
*.png
*.tif
*.gpkg
*.shp
*.pdf
*.csv
!requirements.txt

# JSON Management
*.json              # Ignore by default
!config/*.json      # Track configs
!data/processed/address_variants/*.json  # Track address mappings
!.vscode/*.json     # Track VS Code settings

# GeoJSON Management
data/raw/**/*.geojson       # Ignore raw GeoJSON
!data/processed/*.geojson   # Track processed GeoJSON

# Documentation
!docs/*.md
!*.rst
!CHANGELOG.md
!CONTRIBUTING.md
!data/*/README.md

# Jupyter Notebooks (for analysis documentation)
!notebooks/*.ipynb
*.ipynb_checkpoints

# Analysis outputs
!data/processed/summary_stats/*.json
!data/processed/validation_reports/*.md
!data/processed/metadata/*.yaml

# Exclude raw analysis
data/raw/analysis_temp/
data/interim/

# Templates and configs
!templates/*.j2
!config/*.yaml
!config/*.toml
!.style.yapf
!pyproject.toml
!setup.cfg

# QGIS project files (excluding autosaves)
!*.qgs
!*.qgz
*.qgs~
*.qgz~

# Scripts and tools
!scripts/utils/*.py
!scripts/validation/*.py
!tools/forensics/*.py
!bin/*.sh

# Test files
!tests/**/*.py
!tests/data/fixtures/*.json

# Development
!.devcontainer/Dockerfile
!.github/workflows/*.yml
!docker-compose.yml
!Makefile